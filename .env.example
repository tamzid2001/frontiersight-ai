# Server-side only. Never commit a real key. Never expose to the browser.
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_SAM_MODEL=sam-3.1
META_IMAGE_MODEL=muse-image-1.0

# Clerk (optional identity + billing provider; first-party auth works without it)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Optional durable scene storage; preserves the existing Clerk identity/billing UI.
SCENE_STORE=firestore
CLERK_ISSUER=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=https://frontiersight-ai.vercel.app
FIRESTORE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIRESTORE_USE_ADC=false
FIRESTORE_SERVICE_ACCOUNT_JSON=
WORKSPACE_AUDIT_SECRET=
