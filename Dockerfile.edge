FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY engine ./engine
COPY agents ./agents
COPY integrations ./integrations
COPY services ./services
COPY edge ./edge
COPY sdk ./sdk
COPY apps/web/openapi.json ./apps/web/openapi.json
RUN pip install --no-cache-dir '.[edge]' && useradd --uid 10001 --create-home edgeuser && mkdir /data && chown edgeuser /data
USER edgeuser
ENV EDGE_ALLOW_CONTAINER_BIND=true
VOLUME /data
EXPOSE 8830
CMD ["python","-m","edge.server","--root","/data","--host","0.0.0.0"]
